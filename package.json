{
  "name": "lhu-zbot-tuyensinh",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --continue",
    "build": "turbo run build --continue",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke:compose": "bash ./scripts/phase-0-compose-smoke.sh",
    "db:prisma:generate": "pnpm --filter @lhu/database prisma:generate",
    "db:migrate:deploy": "pnpm --filter @lhu/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @lhu/database db:migrate:dev",
    "db:seed": "pnpm --filter @lhu/database db:seed",
    "db:verify": "pnpm --filter @lhu/database db:verify",
    "db:verify:fresh": "bash ./scripts/phase-2-database-foundation.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.39.4",
    "globals": "^15.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.2.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "deepmerge-ts": "7.1.6"
    }
  }
}
