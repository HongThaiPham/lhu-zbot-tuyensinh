# LHU Admissions Zalo Bot - Phase 1 configuration
#
# Required in all environments unless noted.
# Never commit real credentials.

# Runtime environment: development | test | production
NODE_ENV=development

# Bot role: api | worker
BOT_SERVICE_ROLE=api

# Bot update mode: polling | webhook
ZALO_UPDATE_MODE=polling

# Long-poll timeout sent to Zalo getUpdates (seconds)
ZALO_POLL_TIMEOUT_SECONDS=30

# Public webhook callback URL used by admin webhook management (required in production when ZALO_UPDATE_MODE=webhook)
ZALO_WEBHOOK_URL=https://bot.example.com/webhooks/zalo
# Webhook secret token sent by Zalo in X-Bot-Api-Secret-Token (8-256 chars; required in production when ZALO_UPDATE_MODE=webhook)
ZALO_WEBHOOK_SECRET_TOKEN=replace-with-your-webhook-secret-token

# Zalo bot token (required in production)
ZALO_BOT_TOKEN=replace-with-your-zalo-bot-token

# Bot API listen port (1-65535)
PORT=3001

# PostgreSQL URL (postgresql:// or postgres://)
DATABASE_URL=postgresql://localhost:5432/lhu_zbot?schema=public

# Redis URL (redis:// or rediss://)
REDIS_URL=redis://redis:6379

# Public admin API base URL (safe for browser bundle)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4201

# Required in production.
# Must be non-placeholder, non-empty, at least 32 chars.
APP_ENCRYPTION_KEY=development-only-app-encryption-key-not-for-production

# Session cookie settings
SESSION_COOKIE_NAME=lhu_admin_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SAME_SITE=lax
ADMIN_ORIGIN=http://127.0.0.1:4100
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
TRUST_PROXY=false
# Set true only behind one controlled reverse proxy that overwrites forwarding headers.

# Admin bootstrap command inputs (explicit command only)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Compose database defaults
POSTGRES_DB=lhu_zbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
